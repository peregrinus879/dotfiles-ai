#!/bin/bash
# spar-claude - pinned read-only claude reviewer bridge for the spar skill.
# Flags are hard-coded so no caller can weaken them (AGENTS.md, Known Limitations).
# Modes: init (private handoff directory to stdout)
#        clean <handoff-dir>
#        new <handoff-dir> "<prompt>" (session id to stdout, reply to stderr)
#        resume <sid> <handoff-dir> "<prompt>" (reply to stdout)
# Exit codes: 0 ok, 2 preflight failed, 3 usage limit, 4 stall, 5 reviewer error,
#             64 usage, 124 ceiling.
set -euo pipefail

MODEL="claude-fable-5"
CEILING="${SPAR_BRIDGE_CEILING:-1800}" # absolute seconds per call
STALL="${SPAR_BRIDGE_STALL:-180}"      # kill after this many seconds without a stream event
UUID_RE='^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$'
HANDOFF_RE='^/tmp/spar-[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$'
POSINT_RE='^[1-9][0-9]*$'

usage() {
  echo 'usage: spar-claude init | clean <handoff-dir> | new <handoff-dir> "<prompt>" | resume <sid> <handoff-dir> "<prompt>"' >&2
  exit 64
}

abort() { echo "SPAR-BRIDGE ABORT: $1" >&2; exit 2; }

resolve_scanner() {
  local script
  script=$(realpath -e -- "${BASH_SOURCE[0]}") || abort "cannot resolve bridge source"
  SCANNER=$(realpath -e -- "$(dirname -- "$script")/spar-payload-scan") ||
    abort "cannot resolve the pinned payload scanner"
  [[ -f $SCANNER && ! -L $SCANNER && -x $SCANNER ]] || abort "payload scanner is not executable"
}

scan_payload() {
  resolve_scanner
  printf '%s' "$PROMPT" | "$SCANNER" "$1" || abort "payload failed the outbound content gate"
}

[[ $CEILING =~ $POSINT_RE && $STALL =~ $POSINT_RE ]] ||
  abort "timeout knobs must be positive integers (CEILING=$CEILING STALL=$STALL); zero disables timeout"

validate_tmp_root() {
  if ! command -v realpath >/dev/null || ! command -v stat >/dev/null; then
    abort "realpath and stat are required for handoff validation"
  fi
  [[ ! -L /tmp && -d /tmp && $(realpath -e -- /tmp) == /tmp ]] ||
    abort "/tmp must be a real directory"
}

validate_handoff() {
  local root=$1 entry resolved
  validate_tmp_root
  [[ $root =~ $HANDOFF_RE ]] || abort "handoff path must be /tmp/spar-<UUID>: $root"
  [[ -d $root && ! -L $root ]] || abort "handoff directory is missing or is a symlink: $root"
  [[ $(realpath -e -- "$root") == "$root" ]] || abort "handoff directory escapes /tmp: $root"
  [[ $(stat -c '%u' -- "$root") == $(id -u) ]] || abort "handoff directory is not owned by the current user: $root"
  [[ $(stat -c '%a' -- "$root") == 700 ]] || abort "handoff directory must have mode 700: $root"

  shopt -s nullglob dotglob
  for entry in "$root"/*; do
    [[ -f $entry && ! -L $entry ]] || abort "handoff entries must be regular files: $entry"
    [[ $(stat -c '%u' -- "$entry") == $(id -u) ]] || abort "handoff file is not owned by the current user: $entry"
    [[ $(stat -c '%h' -- "$entry") == 1 ]] || abort "handoff file has hard links: $entry"
    resolved=$(realpath -e -- "$entry") || abort "cannot resolve handoff file: $entry"
    [[ $resolved == "$root/"* ]] || abort "handoff file escapes its session directory: $entry"
  done
  shopt -u nullglob dotglob
}

init_handoff() {
  local sid root
  validate_tmp_root
  sid=$(cat /proc/sys/kernel/random/uuid) || abort "cannot generate a handoff id"
  root="/tmp/spar-$sid"
  (umask 077; mkdir -m 700 -- "$root") || abort "cannot create handoff directory: $root"
  validate_handoff "$root"
  printf '%s\n' "$root"
}

clean_handoff() {
  local root=$1
  validate_tmp_root
  [[ $root =~ $HANDOFF_RE ]] || abort "handoff path must be /tmp/spar-<UUID>: $root"
  [[ -e $root || -L $root ]] || return 0
  validate_handoff "$root"
  rm -rf -- "$root"
}

preflight() {
  local variable auth
  command -v jq >/dev/null || abort "jq is required and missing"
  for variable in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
    ANTHROPIC_PROFILE ANTHROPIC_FEDERATION_RULE_ID ANTHROPIC_ORGANIZATION_ID \
    CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX \
    CLAUDE_CODE_USE_FOUNDRY CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST CLAUDE_CONFIG_DIR; do
    [[ -z ${!variable:-} ]] || abort "$variable is set; claude.ai subscription auth only"
  done
  auth=$(timeout --kill-after=2 30 claude auth status 2>/dev/null) ||
    abort "cannot verify Claude authentication"
  jq -e '.loggedIn == true and .authMethod == "claude.ai" and .apiProvider == "firstParty"' \
    <<<"$auth" >/dev/null 2>&1 ||
    abort "claude is not on claude.ai subscription auth"
}

# Stream claude events through a stall watchdog and require exactly one valid
# terminal result. The owned process group makes every exit path bounded.
stop_group() {
  [[ -n ${pid:-} ]] || return 0
  kill -TERM -- "-$pid" 2>/dev/null || true
  sleep 1
  kill -KILL -- "-$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  pid=""
}

cleanup_stream() {
  stop_group
  [[ -z ${workdir:-} ]] || rm -rf -- "$workdir"
}

stream() { # $1 reply_fd; rest = claude session flags
  local reply_fd=$1 line rc=0 child_rc=0 result="" result_count=0
  shift
  workdir=$(mktemp -d) && [[ -d ${workdir:-} ]] || abort "cannot create a private temp directory"
  mkfifo -m 600 "$workdir/fifo" || abort "cannot create the event fifo"
  pid=""
  trap cleanup_stream EXIT INT TERM
  setsid timeout --kill-after=2 "$CEILING" claude -p "$@" \
    --permission-mode plan --disallowedTools "Write Edit NotebookEdit Bash" \
    --tools "Read,Glob,Grep" \
    --model "$MODEL" --safe-mode --output-format stream-json \
    --include-partial-messages --verbose >"$workdir/fifo" 2>/dev/null <<<"$PROMPT" &
  pid=$!
  # shellcheck disable=SC2094 # the fifo's writer is the background claude process
  while true; do
    IFS= read -t "$STALL" -r line <&3 || { rc=$?; break; }
    jq -e '.type == "result"' <<<"$line" >/dev/null 2>&1 || continue
    ((result_count += 1))
    [[ $result_count == 1 ]] || { echo "SPAR-BRIDGE ERROR: duplicate result event" >&2; exit 5; }
    if jq -e '.is_error == true' <<<"$line" >/dev/null 2>&1; then
      if grep -qiE 'usage limit|rate limit|quota|too many requests|overloaded|429' <<<"$line"; then
        echo "SPAR-BRIDGE LIMIT: reviewer hit a usage limit; surface to the user now: $line" >&2
        exit 3
      fi
      echo "SPAR-BRIDGE ERROR: $line" >&2
      exit 5
    fi
    result=$(jq -er '.result | select(type == "string" and length > 0)' <<<"$line") || {
      echo "SPAR-BRIDGE ERROR: successful result has no reply" >&2
      exit 5
    }
  done 3<"$workdir/fifo"
  if [[ $rc -gt 128 ]]; then # read -t timed out: stall
    echo "SPAR-BRIDGE STALL: no reviewer event for ${STALL}s; killed the call" >&2
    exit 4
  fi
  if wait "$pid"; then child_rc=0; else child_rc=$?; fi
  pid=""
  if [[ $child_rc == 124 ]]; then
    echo "SPAR-BRIDGE CEILING: call exceeded ${CEILING}s" >&2
    exit 124
  fi
  [[ $child_rc == 0 ]] || { echo "SPAR-BRIDGE ERROR: reviewer exited $child_rc" >&2; exit 5; }
  [[ $result_count == 1 && -n $result ]] || {
    echo "SPAR-BRIDGE ERROR: reviewer ended without one successful result" >&2
    exit 5
  }
  printf '%s\n' "$result" >&"$reply_fd"
}

[[ $# -ge 1 ]] || usage
mode=$1
case $mode in
  init)
    [[ $# -eq 1 ]] || usage
    init_handoff ;;
  clean)
    [[ $# -eq 2 ]] || usage
    clean_handoff "$2" ;;
  new)
    [[ $# -eq 3 ]] || usage
    validate_handoff "$2"
    PROMPT=$3
    scan_payload "$2"
    sid=$(cat /proc/sys/kernel/random/uuid)
    preflight
    stream 2 --session-id "$sid"
    printf '%s\n' "$sid" ;;
  resume)
    [[ $# -eq 4 ]] || usage
    [[ $2 =~ $UUID_RE ]] || abort "resume session id is not a UUID: $2"
    validate_handoff "$3"
    PROMPT=$4
    scan_payload "$3"
    preflight
    stream 1 --resume "$2" ;;
  *) usage ;;
esac
