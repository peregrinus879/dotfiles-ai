#!/usr/bin/python3 -I
"""Fail closed when a spar prompt or handoff contains sensitive material."""

import re
import shlex
import sys
from pathlib import Path


PRIVATE_KEY = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")
OPENAI_KEY = re.compile(r"\bsk-[A-Za-z0-9_-]{16,}\b")
GITHUB_TOKEN = re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b")
GITHUB_FINE_GRAINED = re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b")
AWS_KEY = re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")
SECRET_ASSIGNMENT = re.compile(
    r"""(?im)^[ \t+\-]*(?:export\s+)?["']?"""
    r"[A-Z0-9_]*(?:API_KEY|AUTH_TOKEN|ACCESS_TOKEN|CLIENT_SECRET|PASSWORD|PASSWD|PRIVATE_KEY)"
    r"""[A-Z0-9_]*["']?\s*[:=]\s*(.*?)\s*$"""
)
SAFE_VALUE = re.compile(
    r"(?i)(?:example(?:[-_ ][a-z0-9]+)*|placeholder(?:[-_ ][a-z0-9]+)*|redacted|"
    r"not[-_ ]?set|replace[-_ ]?me|change[-_ ]?me|dummy(?:[-_ ][a-z0-9]+)*|"
    r"fake(?:[-_ ][a-z0-9]+)*|test(?:[-_ ][a-z0-9]+)*|your[-_ ][a-z0-9_-]+|"
    r"\$\{[A-Z_][A-Z0-9_]*\}|\{env:[^}\r\n]+\}|<[^>\r\n]{1,80}>)"
)
NPM_TOKEN = re.compile(r"(?im)^[ \t+\-]*//[^\r\n]*:_authToken\s*=\s*([^\s#]+)")
NETRC_PASSWORD = re.compile(r"(?im)^[ \t+\-]*password\s+\S+")
NETRC_MACHINE = re.compile(r"(?im)^[ \t+\-]*machine\s+\S+")
RESERVED_HANDOFF_NAMES = {
    ".git",
    "agents.md",
    "agents.override.md",
    "claude.md",
    "claude.local.md",
}


def reject(label: str, rule: str) -> None:
    print(f"SPAR-PAYLOAD REJECT: {label}: {rule}", file=sys.stderr)
    raise SystemExit(2)


def safe_assignment_value(value: str) -> bool:
    try:
        tokens = shlex.split(value, comments=False, posix=True)
    except ValueError:
        return False
    return not tokens or (
        len(tokens) == 1 and (tokens[0] == "" or SAFE_VALUE.fullmatch(tokens[0]) is not None)
    )


def sensitive_path(value: str) -> bool:
    path = value.replace("\\", "/").lower().strip("\"'")
    parts = path.split("/")
    name = parts[-1]
    return (
        name == ".env"
        or name.startswith(".env.")
        or re.search(r"\.(?:key|pem)(?:[._~-].*)?$", name) is not None
        or any(re.fullmatch(r"secrets?(?:[._~-].*)?", part) for part in parts)
        or "credentials" in name
        or re.fullmatch(r"auth\.json(?:[._~-].*)?", name) is not None
        or re.fullmatch(r"\.(?:netrc|npmrc|pypirc)(?:[._~-].*)?", name) is not None
    )


def diff_paths(text: str):
    for line in text.splitlines():
        if line.startswith("diff --git "):
            try:
                parts = shlex.split(line)
            except ValueError:
                parts = line.split()
            yield from parts[2:]
            continue
        for prefix in (
            "diff --cc ",
            "diff --combined ",
            "--- ",
            "+++ ",
            "rename from ",
            "rename to ",
            "copy from ",
            "copy to ",
        ):
            if line.startswith(prefix):
                yield line[len(prefix) :].split("\t", 1)[0].strip()
                break


def scan(label: str, data: bytes) -> None:
    if b"\0" in data:
        reject(label, "binary content")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        reject(label, "non-UTF-8 content")

    for path in diff_paths(text):
        if sensitive_path(path):
            reject(label, "sensitive diff path")
    if PRIVATE_KEY.search(text):
        reject(label, "private-key envelope")
    if OPENAI_KEY.search(text):
        reject(label, "API-key shape")
    if GITHUB_TOKEN.search(text):
        reject(label, "GitHub-token shape")
    if GITHUB_FINE_GRAINED.search(text):
        reject(label, "GitHub fine-grained token shape")
    if AWS_KEY.search(text):
        reject(label, "AWS-key shape")
    for match in SECRET_ASSIGNMENT.finditer(text):
        if not safe_assignment_value(match.group(1)):
            reject(label, "credential assignment")
    for match in NPM_TOKEN.finditer(text):
        if not SAFE_VALUE.fullmatch(match.group(1)):
            reject(label, "npm auth-token assignment")
    if NETRC_MACHINE.search(text) and NETRC_PASSWORD.search(text):
        reject(label, "netrc credential shape")


def main() -> None:
    if len(sys.argv) != 2:
        print("usage: spar-payload-scan <handoff-dir>", file=sys.stderr)
        raise SystemExit(64)

    root = Path(sys.argv[1])
    scan("prompt", sys.stdin.buffer.read())
    try:
        entries = sorted(root.iterdir())
    except OSError:
        reject("handoff", "unreadable directory")
    for entry in entries:
        if entry.name.casefold() in RESERVED_HANDOFF_NAMES:
            reject(entry.name, "reviewer instruction or repository marker")
        if sensitive_path(entry.name):
            reject(entry.name, "sensitive handoff path")
        try:
            data = entry.read_bytes()
        except OSError:
            reject(entry.name, "unreadable file")
        scan(entry.name, data)


if __name__ == "__main__":
    main()
