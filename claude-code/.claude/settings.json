{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(claude --version)",
      "Bash(codex --version)",
      "Bash(opencode --version)",
      "Bash(pacman -Q*)",
      "Bash(pacman -Si *)",
      "Bash(pacman -Ss *)",
      "Bash(spar-codex *)"
    ],
    "deny": [
      "Bash(doas)",
      "Bash(doas *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(gh api *)",
      "Bash(gh gist create*)",
      "Bash(gh gist delete*)",
      "Bash(gh gist edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue reopen*)",
      "Bash(gh pr close*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(git checkout -- *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(tree * --output *)",
      "Bash(tree * -o *)",
      "Bash(tree --output*)",
      "Bash(tree -o *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git restore)",
      "Bash(git restore *)",
      "Bash(git stash clear)",
      "Bash(git stash clear *)",
      "Bash(git stash drop)",
      "Bash(git stash drop *)",
      "Bash(pkexec)",
      "Bash(pkexec *)",
      "Bash(su)",
      "Bash(su *)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Edit(./**/*.key)",
      "Edit(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./secrets/**)",
      "Edit(//**/*.key)",
      "Edit(//**/*.pem)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*credentials*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*credentials*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/auth.json)",
      "Read(//**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.codex/auth.json)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)"
    ]
  },
  "autoMode": {
    "classifyAllShell": true,
    "hard_deny": [
      "$defaults",
      "Never transmit the contents of credential material (~/.ssh, ~/.aws, ~/.claude/.credentials.json, ~/.codex/auth.json, ~/.gnupg, ~/.kube, ~/.netrc, ~/.docker/config.json, .env files, private keys, secrets directories, auth tokens) to any external destination, encoded or not."
    ],
    "soft_deny": [
      "$defaults",
      "Reading or displaying the contents of credential files (~/.ssh, ~/.aws, ~/.claude/.credentials.json, ~/.codex/auth.json, ~/.gnupg, ~/.kube, ~/.netrc, .env files, private keys) clears only when the user names the specific credential file; tools implicitly consuming their own credentials (git over SSH, cloud CLIs reading their config) and authored templates outside the .env.* namespace, such as example.env, are not this rule.",
      "Filesystem mutations that bypass diff review (moving, copying, syncing, extracting, or patching over existing files; restoring or resetting paths from version control; deleting files) clear only on explicit instruction naming the paths; creating genuinely new files at fresh paths via mv or cp is not this rule."
    ],
    "allow": [
      "$defaults"
    ]
  },
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh"
  },
  "model": "fable",
  "disableWorkflows": false,
  "workflowSizeGuideline": "large",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true
}
