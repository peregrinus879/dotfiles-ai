{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(file *)",
      "Bash(gh search *)",
      "Bash(tree *)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Edit",
      "NotebookEdit",
      "Write"
    ],
    "deny": [
      "Bash(* >*)",
      "Bash(* | tee*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(tree * --output *)",
      "Bash(tree * -o *)",
      "Bash(tree --output*)",
      "Bash(tree -o *)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*credentials*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "disableAutoMode": "disable",
  "model": "claude-fable-5",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen"
}
