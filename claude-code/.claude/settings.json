{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(gh search *)",
      "Bash(jq *)",
      "Bash(pacman -Q*)",
      "Bash(pacman -Si *)",
      "Bash(pacman -Ss *)",
      "Bash(tree *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(tree * --output *)",
      "Bash(tree * -o *)",
      "Bash(tree --output*)",
      "Bash(tree -o *)",
      "Edit(./**/*.key)",
      "Edit(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./secrets/**)",
      "Edit(//**/*.key)",
      "Edit(//**/*.pem)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*credentials*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*credentials*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(* >*)",
      "Bash(* | tee*)",
      "Edit",
      "NotebookEdit",
      "Write"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never transmit the contents of credential material (~/.ssh, ~/.aws, ~/.gnupg, ~/.kube, ~/.netrc, ~/.docker/config.json, .env files with real values, private keys, secrets directories, auth tokens) to any external destination, encoded or not."
    ],
    "soft_deny": [
      "$defaults",
      "Reading or displaying the contents of credential files (~/.ssh, ~/.aws, ~/.gnupg, ~/.kube, ~/.netrc, .env files with real values, private keys) clears only when the user names the specific credential file; tools implicitly consuming their own credentials (git over SSH, cloud CLIs reading their config) and authored placeholders or templates like .env.example are not this rule."
    ]
  },
  "model": "claude-fable-5",
  "disableWorkflows": false,
  "workflowSizeGuideline": "unrestricted",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true
}
