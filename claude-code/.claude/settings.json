{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh search *)",
      "Bash(jq *)",
      "Bash(pacman -Q*)",
      "Bash(pacman -Si *)",
      "Bash(pacman -Ss *)",
      "Bash(tree *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(tree * --output *)",
      "Bash(tree * -o *)",
      "Bash(tree --output*)",
      "Bash(tree -o *)",
      "Edit(./**/*.key)",
      "Edit(./**/*.pem)",
      "Edit(./.env)",
      "Edit(./secrets/**)",
      "Edit(//**/*.key)",
      "Edit(//**/*.pem)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*credentials*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(//**/*credentials*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(* >*)",
      "Bash(* | tee*)",
      "Edit",
      "NotebookEdit",
      "Write"
    ]
  },
  "model": "claude-fable-5",
  "disableWorkflows": false,
  "workflowSizeGuideline": "unrestricted",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "disableAutoMode": "disable",
  "skipWorkflowUsageWarning": true
}
