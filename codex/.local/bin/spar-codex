#!/bin/bash
# spar-codex - pinned read-only codex reviewer bridge for the spar skill.
# Flags are hard-coded so no caller can weaken them (AGENTS.md and docs/maintenance.md).
# Modes: init (private handoff directory to stdout)
#        clean <handoff-dir>
#        new <handoff-dir> "<prompt>" (thread id to stdout, reply to stderr)
#        resume <sid> <handoff-dir> "<prompt>" (reply to stdout)
# Exit codes: 0 ok, 2 preflight failed, 3 usage limit, 4 stall, 64 usage, 124 ceiling.
set -euo pipefail

MODEL="gpt-5.6-sol"
CEILING="${SPAR_BRIDGE_CEILING:-1800}" # absolute seconds per call
STALL="${SPAR_BRIDGE_STALL:-180}"      # kill after this many seconds without a JSON event
UUID_RE='^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$'
HANDOFF_RE='^/tmp/spar-[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$'
POSINT_RE='^[1-9][0-9]*$'
REVIEWER_PROFILE='permissions.spar-reviewer={description="Read-only spar reviewer",extends=":read-only",filesystem={":tmpdir"="read",":slash_tmp"="read","~/.aws"="deny","~/.claude/.credentials.json"="deny","~/.codex/auth.json"="deny","~/.config/gh/hosts.yml"="deny","~/.docker/config.json"="deny","~/.gnupg"="deny","~/.kube"="deny","~/.local/share/opencode/auth.json"="deny","~/.netrc"="deny","~/.npmrc"="deny","~/.pypirc"="deny","~/.ssh"="deny",glob_scan_max_depth=64,":workspace_roots"={"."="read",".env"="deny",".env.*"="deny","secrets"="deny","**/*.key"="deny","**/*.pem"="deny","**/*credentials*"="deny"}},network={enabled=false}}'
PLUGIN_DISABLE_OVERRIDES=(
  -c 'features.plugins=false'
  -c 'features.remote_plugin=false'
)
CODEX_COMMON=(
  --ignore-user-config
  --ignore-rules
  --strict-config
  -c 'forced_login_method="chatgpt"'
  -c 'model_provider="openai"'
  -c "model=\"$MODEL\""
  -c 'model_reasoning_effort="xhigh"'
  -c 'approval_policy="never"'
  -c 'approvals_reviewer="user"'
  -c 'default_permissions="spar-reviewer"'
  -c "$REVIEWER_PROFILE"
  -c 'mcp_servers={}'
  -c 'apps._default.enabled=false'
  -c 'agents.enabled=false'
  -c 'features.apps=false'
  -c 'features.hooks=false'
  -c 'features.multi_agent=false'
  "${PLUGIN_DISABLE_OVERRIDES[@]}"
  -c 'features.skill_mcp_dependency_install=false'
  -c 'features.shell_snapshot=false'
  -c 'shell_environment_policy.inherit="core"'
  -c 'shell_environment_policy.ignore_default_excludes=false'
  -c 'web_search="disabled"'
  -c 'service_tier="fast"'
  -c 'features.fast_mode=true'
)

usage() {
  echo 'usage: spar-codex init | clean <handoff-dir> | new <handoff-dir> "<prompt>" | resume <sid> <handoff-dir> "<prompt>"' >&2
  exit 64
}

abort() { echo "SPAR-BRIDGE ABORT: $1" >&2; exit 2; }

resolve_scanner() {
  local script root
  script=$(realpath -e -- "${BASH_SOURCE[0]}") || abort "cannot resolve bridge source"
  root=$(realpath -e -- "$(dirname -- "$script")/../../..") || abort "cannot resolve repository root"
  SCANNER=$(realpath -e -- "$root/claude-code/.local/bin/spar-payload-scan") ||
    abort "cannot resolve the pinned payload scanner"
  [[ -f $SCANNER && ! -L $SCANNER && -x $SCANNER ]] || abort "payload scanner is not executable"
}

scan_payload() {
  resolve_scanner
  printf '%s' "$PROMPT" | "$SCANNER" "$1" || abort "payload failed the outbound content gate"
}

[[ $CEILING =~ $POSINT_RE && $STALL =~ $POSINT_RE ]] ||
  abort "timeout knobs must be positive integers (CEILING=$CEILING STALL=$STALL); zero disables timeout"

validate_tmp_root() {
  if ! command -v realpath >/dev/null || ! command -v stat >/dev/null; then
    abort "realpath and stat are required for handoff validation"
  fi
  [[ ! -L /tmp && -d /tmp && $(realpath -e -- /tmp) == /tmp ]] ||
    abort "/tmp must be a real directory"
}

validate_handoff() {
  local root=$1 entry resolved
  validate_tmp_root
  [[ $root =~ $HANDOFF_RE ]] || abort "handoff path must be /tmp/spar-<UUID>: $root"
  [[ -d $root && ! -L $root ]] || abort "handoff directory is missing or is a symlink: $root"
  [[ $(realpath -e -- "$root") == "$root" ]] || abort "handoff directory escapes /tmp: $root"
  [[ $(stat -c '%u' -- "$root") == $(id -u) ]] || abort "handoff directory is not owned by the current user: $root"
  [[ $(stat -c '%a' -- "$root") == 700 ]] || abort "handoff directory must have mode 700: $root"

  shopt -s nullglob dotglob
  for entry in "$root"/*; do
    [[ -f $entry && ! -L $entry ]] || abort "handoff entries must be regular files: $entry"
    [[ $(stat -c '%u' -- "$entry") == $(id -u) ]] || abort "handoff file is not owned by the current user: $entry"
    [[ $(stat -c '%h' -- "$entry") == 1 ]] || abort "handoff file has hard links: $entry"
    resolved=$(realpath -e -- "$entry") || abort "cannot resolve handoff file: $entry"
    [[ $resolved == "$root/"* ]] || abort "handoff file escapes its session directory: $entry"
  done
  shopt -u nullglob dotglob
}

init_handoff() {
  local sid root
  validate_tmp_root
  sid=$(cat /proc/sys/kernel/random/uuid) || abort "cannot generate a handoff id"
  root="/tmp/spar-$sid"
  (umask 077; mkdir -m 700 -- "$root") || abort "cannot create handoff directory: $root"
  validate_handoff "$root"
  printf '%s\n' "$root"
}

clean_handoff() {
  local root=$1
  validate_tmp_root
  [[ $root =~ $HANDOFF_RE ]] || abort "handoff path must be /tmp/spar-<UUID>: $root"
  [[ -e $root || -L $root ]] || return 0
  validate_handoff "$root"
  rm -rf -- "$root"
}

preflight() {
  command -v jq >/dev/null || abort "jq is required and missing"
  [[ -z ${CODEX_API_KEY:-} ]] || abort "CODEX_API_KEY is set; subscription auth only"
  [[ $(timeout --kill-after=2 30 codex login status 2>&1) == "Logged in using ChatGPT" ]] ||
    abort "codex is not on ChatGPT subscription auth"
  local installed
  installed=$(timeout --kill-after=2 30 codex plugin list --json "${PLUGIN_DISABLE_OVERRIDES[@]}" 2>/dev/null |
    jq -r '.installed | length' 2>/dev/null) || installed=""
  [[ $installed == 0 ]] ||
    abort "cannot verify codex plugins are disabled (effective installed: ${installed:-unknown}); fail closed"
}

# Stream Codex events through a stall watchdog and require exactly one completed
# turn. The owned process group makes every exit path bounded.
stop_group() {
  [[ -n ${pid:-} ]] || return 0
  kill -TERM -- "-$pid" 2>/dev/null || true
  sleep 1
  kill -KILL -- "-$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  pid=""
}

cleanup_stream() {
  stop_group
  [[ -z ${workdir:-} ]] || rm -rf -- "$workdir"
}

stream() {
  local reply_fd=$1 line rc=0 child_rc=0 thread_id="" thread_count=0 turn_count=0 reply=""
  shift
  local pre=() post=() seen_sep=0 a
  for a in "$@"; do
    if [[ $a == "--" && $seen_sep == 0 ]]; then seen_sep=1; continue; fi
    if [[ $seen_sep == 0 ]]; then pre+=("$a"); else post+=("$a"); fi
  done
  workdir=$(mktemp -d) && [[ -d ${workdir:-} ]] || abort "cannot create a private temp directory"
  mkfifo -m 600 "$workdir/fifo" || abort "cannot create the event fifo"
  fifo="$workdir/fifo"
  pid=""
  trap cleanup_stream EXIT INT TERM
  setsid timeout --kill-after=2 "$CEILING" codex exec "${pre[@]}" --json -- "${post[@]}" \
    </dev/null >"$fifo" 2>/dev/null &
  pid=$!
  # shellcheck disable=SC2094 # the fifo's writer is the background codex process
  while true; do
    IFS= read -t "$STALL" -r line <&3 || { rc=$?; break; }
    case $(jq -r '.type // empty' <<<"$line" 2>/dev/null) in
      thread.started)
        ((thread_count += 1))
        [[ $thread_count == 1 ]] || { echo "SPAR-BRIDGE ERROR: duplicate thread event" >&2; exit 5; }
        thread_id=$(jq -er '.thread_id | select(type == "string")' <<<"$line") || {
          echo "SPAR-BRIDGE ERROR: malformed thread event" >&2
          exit 5
        } ;;
      item.completed)
        if [[ $(jq -r '.item.type // empty' <<<"$line") == agent_message ]]; then
          reply=$(jq -er '.item.text | select(type == "string" and length > 0)' <<<"$line") || true
        fi ;;
      error | turn.failed)
        if grep -qiE 'usage limit|rate limit|quota|too many requests|overloaded|429' <<<"$line"; then
          echo "SPAR-BRIDGE LIMIT: reviewer hit a usage limit; surface to the user now: $line" >&2
          exit 3
        fi
        echo "SPAR-BRIDGE ERROR: $line" >&2
        exit 5 ;;
      turn.completed)
        ((turn_count += 1))
        [[ $turn_count == 1 ]] || { echo "SPAR-BRIDGE ERROR: duplicate turn completion" >&2; exit 5; } ;;
    esac
  done 3<"$fifo"
  if [[ $rc -gt 128 ]]; then # read -t timed out: stall
    echo "SPAR-BRIDGE STALL: no reviewer event for ${STALL}s; killed the call" >&2
    exit 4
  fi
  if wait "$pid"; then child_rc=0; else child_rc=$?; fi
  pid=""
  if [[ $child_rc == 124 ]]; then
    echo "SPAR-BRIDGE CEILING: call exceeded ${CEILING}s" >&2
    exit 124
  fi
  [[ $child_rc == 0 ]] || { echo "SPAR-BRIDGE ERROR: reviewer exited $child_rc" >&2; exit 5; }
  [[ $turn_count == 1 && -n $reply ]] || {
    echo "SPAR-BRIDGE ERROR: reviewer ended without one completed turn and reply" >&2
    exit 5
  }
  if [[ $reply_fd == 2 ]]; then
    [[ $thread_count == 1 && $thread_id =~ $UUID_RE ]] || {
      echo "SPAR-BRIDGE ERROR: new review has no valid thread id" >&2
      exit 5
    }
    printf '%s\n' "$thread_id"
  fi
  printf '%s\n' "$reply" >&"$reply_fd"
}

[[ $# -ge 1 ]] || usage
mode=$1
case $mode in
  init)
    [[ $# -eq 1 ]] || usage
    init_handoff ;;
  clean)
    [[ $# -eq 2 ]] || usage
    clean_handoff "$2" ;;
  new)
    [[ $# -eq 3 ]] || usage
    validate_handoff "$2"
    PROMPT=$3
    scan_payload "$2"
    preflight; stream 2 "${CODEX_COMMON[@]}" -- "$PROMPT" ;;
  resume)
    [[ $# -eq 4 ]] || usage
    [[ $2 =~ $UUID_RE ]] || abort "resume session id is not a UUID: $2"
    validate_handoff "$3"
    PROMPT=$4
    scan_payload "$3"
    preflight; stream 1 resume "${CODEX_COMMON[@]}" -- "$2" "$PROMPT" ;;
  *) usage ;;
esac
