#!/usr/bin/env bash
# commit-apply - commit the recorded candidate verbatim and verify the result.
#
# Usage: commit-apply
#
# Refuses when the index tree, parent, branch, or Git identity no longer equal
# the record commit-candidate wrote (present a fresh packet), commits the
# recorded message verbatim on the current branch without amending or skipping
# hooks, then verifies the new commit's tree, parent, branch, full message, and
# author and committer addresses against the record. When the result differs,
# which means a hook restaged content or rewrote the message, the branch is
# moved back to the recorded parent with a compare-and-swap so the branch only
# ever advances by the exact candidate; the rejected commit stays unreachable
# for inspection, the record is kept as record.failed, and the exact difference
# is printed. Nothing is ever amended. On success the commit id joins the
# committed list that publish-bind reports as provenance.
#
# Exit codes: 0 committed and verified, 2 candidate changed or missing,
# 3 the commit differed and was rejected, 64 usage.
set -euo pipefail

record_root=${EYRAGENTS_RECORD_ROOT:-/tmp/eyragents-$(id -u)}
[[ $# -eq 0 ]] || { printf 'usage: commit-apply\n' >&2; exit 64; }
fail() {
  printf 'commit-apply: %s\n' "$1" >&2
  exit "${2:-3}"
}

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'not inside a Git repository' 2
record_dir="$record_root/$(printf '%s' "$toplevel" | sha256sum | cut -c1-16)"
[[ -f $record_dir/record && -f $record_dir/message ]] || fail 'no candidate recorded; run commit-candidate and present the packet first' 2

tree='' parent='' branch='' email=''
while IFS='=' read -r key value; do
  case $key in
    tree) tree=$value ;;
    parent) parent=$value ;;
    branch) branch=$value ;;
    email) email=$value ;;
  esac
done <"$record_dir/record"

changed=()
now=$(git write-tree); [[ $now == "$tree" ]] || changed+=("tree $tree is now $now")
now=$(git rev-parse HEAD); [[ $now == "$parent" ]] || changed+=("parent $parent is now $now")
now=$(git branch --show-current); [[ $now == "$branch" ]] || changed+=("branch $branch is now $now")
now=$(git config user.email || true); [[ $now == "$email" ]] || changed+=("identity $email is now $now")
if (( ${#changed[@]} > 0 )); then
  printf 'commit-apply: the candidate changed since the packet; present a fresh one:\n' >&2
  printf '  %s\n' "${changed[@]}" >&2
  exit 2
fi

git commit -q --cleanup=verbatim -F "$record_dir/message"

expected=$(<"$record_dir/message")
actual=$(git log -1 --format=%B)
differs=()
now=$(git rev-parse 'HEAD^{tree}'); [[ $now == "$tree" ]] || differs+=("tree: expected $tree, got $now")
now=$(git rev-parse 'HEAD^'); [[ $now == "$parent" ]] || differs+=("parent: expected $parent, got $now")
now=$(git branch --show-current); [[ $now == "$branch" ]] || differs+=("branch: expected $branch, got $now")
[[ $actual == "$expected" ]] || differs+=("message: the committed message differs from the approved one")
for address in $(git log -1 --format='%ae %ce'); do
  [[ $address == "$email" ]] || differs+=("identity: expected $email, got $address")
done
if (( ${#differs[@]} > 0 )); then
  rejected=$(git rev-parse HEAD)
  # A hook may have detached HEAD; put the session back on the branch first.
  [[ $(git symbolic-ref -q HEAD || true) == "refs/heads/$branch" ]] || git symbolic-ref HEAD "refs/heads/$branch"
  rejected_tip=$(git rev-parse "refs/heads/$branch")
  git update-ref -m 'commit-apply: rejected a commit that differs from the candidate' "refs/heads/$branch" "$parent" "$rejected_tip"
  mv -f -- "$record_dir/record" "$record_dir/record.failed"
  rm -f -- "$record_dir/message"
  printf 'commit-apply: the commit differed from the approved candidate and was rejected; %s is back at %s and the rejected commit %s is unreachable. Stop for H, do not amend:\n' "$branch" "$parent" "$rejected" >&2
  printf '  %s\n' "${differs[@]}" >&2
  exit 3
fi

git rev-parse HEAD >>"$record_dir/committed"
tail -n 200 -- "$record_dir/committed" >"$record_dir/committed.tmp" && mv -f -- "$record_dir/committed.tmp" "$record_dir/committed"
rm -f -- "$record_dir/record" "$record_dir/message" "$record_dir/record.failed"
printf 'hash: %s %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
printf 'upstream: %s\n' "$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || printf none)"
