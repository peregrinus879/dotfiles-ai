#!/usr/bin/env bash
# commit-candidate - stage the intended paths and record the exact candidate.
#
# Usage: commit-candidate [--message-file FILE] -- <path>...
#        commit-candidate --show | --clear
#
# The proposed message comes from FILE or stdin and is validated first: a
# `<type>[(scope)]: <subject>` first line of at most 50 characters, a blank
# second line, a Co-Authored-By trailer with a vendor no-reply address, and no
# session metadata. The script then confirms the Git identity is a GitHub
# no-reply address, refuses an index that already holds changes outside the
# named paths, stages exactly those paths, runs the payload scanner over the
# staged diff, screens added lines for machine and user identifiers, and
# records the candidate (tree, parent, branch, message) under the record root.
# commit-apply commits it verbatim, and commit-gate denies every other `git
# commit`. The output carries the packet inputs.
#
# Records live under EYRAGENTS_RECORD_ROOT (default /tmp/eyragents-<uid>), one
# directory per repository. Exit codes: 0 recorded, 2 message rejected or
# scanner finding (no record kept), 3 repository or index state refused,
# 64 usage.
set -euo pipefail

record_root=${EYRAGENTS_RECORD_ROOT:-/tmp/eyragents-$(id -u)}
scanner=$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")/../../spar/scripts/spar-payload-scan

usage() {
  printf 'usage: commit-candidate [--message-file FILE] -- <path>... | --show | --clear\n' >&2
  exit 64
}
fail() {
  printf 'commit-candidate: %s\n' "$1" >&2
  exit "${2:-3}"
}

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'not inside a Git repository'
record_dir="$record_root/$(printf '%s' "$toplevel" | sha256sum | cut -c1-16)"

case ${1:-} in
  --show)
    [[ -f $record_dir/record ]] || fail 'no candidate recorded'
    cat "$record_dir/record"
    printf -- '--- message\n'
    cat "$record_dir/message"
    exit 0 ;;
  --clear)
    rm -f -- "$record_dir/record" "$record_dir/message"
    printf 'candidate cleared\n'
    exit 0 ;;
esac

message_file=
while [[ $# -gt 0 ]]; do
  case $1 in
    --message-file) [[ $# -ge 2 ]] || usage; message_file=$2; shift 2 ;;
    --) shift; break ;;
    -*) usage ;;
    *) break ;;
  esac
done
[[ $# -gt 0 ]] || usage

if [[ -n $message_file ]]; then message=$(<"$message_file"); else message=$(cat); fi
subject=${message%%$'\n'*}
subject_format='^(feat|fix|docs|refactor|style|test|chore)(\([^)]+\))?: [a-z0-9]'
[[ $subject =~ $subject_format ]] ||
  fail "subject must read '<type>[(scope)]: <lowercase imperative>': $subject" 2
(( ${#subject} <= 50 )) || fail "subject exceeds 50 characters (${#subject}): $subject" 2
[[ -z $(sed -n '2p' <<<"$message") ]] || fail 'the second line of the message must be blank' 2
grep -qE '^Co-Authored-By: .+ <noreply@(anthropic\.com|openai\.com)>$' <<<"$message" ||
  fail 'message lacks a Co-Authored-By trailer with a vendor no-reply address' 2
if grep -qiE 'claude\.ai/code|Claude-Session:|session_[0-9A-Za-z]{8,}' <<<"$message"; then
  fail 'message carries session metadata' 2
fi

email=$(git config user.email || true)
[[ $email == *@users.noreply.github.com ]] || fail 'git identity is not a GitHub no-reply address'
branch=$(git branch --show-current)
[[ -n $branch ]] || fail 'detached HEAD; check out a branch first'
git rev-parse --verify -q HEAD >/dev/null || fail 'the repository has no commits yet'

intended=()
for path in "$@"; do intended+=("$(realpath -m --relative-to="$toplevel" -- "$path")"); done
covered() {
  local staged=$1 path
  for path in "${intended[@]}"; do
    [[ $staged == "$path" || $staged == "$path"/* ]] && return 0
  done
  return 1
}
while IFS= read -r staged; do
  [[ -z $staged ]] && continue
  covered "$staged" || fail "index already holds an unrelated staged change: $staged"
done < <(git diff --cached --name-only)

git add -- "$@"
if git diff --cached --quiet; then fail 'nothing is staged for the given paths'; fi

tree=$(git write-tree)
parent=$(git rev-parse HEAD)
mkdir -p -- "$record_root" "$record_dir"
chmod 700 -- "$record_root" "$record_dir"
printf '%s\n' "$message" >"$record_dir/message"
printf 'toplevel=%s\nbranch=%s\nparent=%s\ntree=%s\nemail=%s\nrecorded=%s\n' \
  "$toplevel" "$branch" "$parent" "$tree" "$email" "$(date -u +%FT%TZ)" >"$record_dir/record"

if ! git diff --cached | "$scanner" diff; then
  rm -f -- "$record_dir/record" "$record_dir/message"
  fail 'the payload scanner rejected the staged diff; resolve the finding, never stage around it' 2
fi

host=$(hostname 2>/dev/null || true)
user=${USER:-$(id -un)}
pattern="${HOME}|\\b${user}\\b"
[[ -n $host ]] && pattern="$pattern|\\b${host}\\b"
hits=$(git diff --cached | grep -nE '^\+' | grep -vE '^[0-9]+:\+\+\+ ' | grep -iE -- "$pattern" || true)

printf '== stat\n'
git diff --cached --stat -M
printf '== candidate\ntree=%s\nparent=%s\nbranch=%s\n' "$tree" "$parent" "$branch"
printf 'scan: accepted\n'
if git diff --quiet; then printf 'worktree equals index: yes\n'; else printf 'worktree equals index: no (tracked files carry unstaged changes; the gates ran on a superset)\n'; fi
untracked=$(git ls-files --others --exclude-standard | tr '\n' ' ')
printf 'untracked: %s\n' "${untracked:-none}"
if [[ -n $hits ]]; then printf 'privacy hits (judge each):\n%s\n' "$hits"; else printf 'privacy hits: none\n'; fi
printf '== message\n%s\n' "$message"
printf 'recorded: %s\n' "$record_dir"
