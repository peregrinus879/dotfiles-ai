#!/usr/bin/env bash
# publish-bind - bind and review a push before it is presented.
#
# Usage: publish-bind [--remote <remote> --branch <branch>] [<ref>]
#
# Resolves the destination from the branch's configured upstream, or from the
# explicit --remote and --branch H named, the reviewed commit id, and the base
# as the destination branch's tracking ref, the last known destination tip,
# assumed without a fetch. Stops as destructive when the reviewed commit does
# not descend from the base. Lists every commit in the delta with its
# identities, marks which ones commit-apply made, runs the payload scanner
# over the flat diff and over every commit's patch, and lists client-side
# hooks, push options, and tags the push would carry. Only when every check
# passes does it record the binding for publish-verify and print the push
# command, bound to both ends and shell-quoted, with -C naming the repository
# root so it runs from any directory. Any earlier binding is dropped first.
#
# Exit codes: 0 bound and clean, 2 scanner or identity finding, 3 no
# destination, 4 no tracking ref (first publication, review complete history),
# 5 destructive, 64 usage.
set -euo pipefail

record_root=${EYRAGENTS_RECORD_ROOT:-/tmp/eyragents-$(id -u)}
scanner=$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")/../../spar/scripts/spar-payload-scan
usage() {
  printf 'usage: publish-bind [--remote <remote> --branch <branch>] [<ref>]\n' >&2
  exit 64
}
fail() {
  printf 'publish-bind: %s\n' "$1" >&2
  exit "${2:-3}"
}

remote='' branch='' ref=HEAD
while [[ $# -gt 0 ]]; do
  case $1 in
    --remote) [[ $# -ge 2 ]] || usage; remote=$2; shift 2 ;;
    --branch) [[ $# -ge 2 ]] || usage; branch=$2; shift 2 ;;
    -*) usage ;;
    *) [[ $ref == HEAD ]] || usage; ref=$1; shift ;;
  esac
done
[[ -z $remote && -z $branch || -n $remote && -n $branch ]] || usage

toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || fail 'not inside a Git repository'
record_dir="$record_root/$(printf '%s' "$toplevel" | sha256sum | cut -c1-16)"
rm -f -- "$record_dir/publish"

reviewed=$(git rev-parse --verify -q "$ref^{commit}") || fail "unknown ref: $ref"
if [[ $ref == HEAD ]]; then local_branch=$(git branch --show-current); else local_branch=${ref#refs/heads/}; fi
[[ -n $local_branch ]] || fail 'detached HEAD has no destination; name the branch'
if [[ -z $remote ]]; then
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "$local_branch@{u}" 2>/dev/null) ||
    fail "no destination: $local_branch has no configured upstream; nothing to publish unless H names one with --remote and --branch" 3
  remote=${upstream%%/*}
  branch=${upstream#*/}
fi
git remote get-url -- "$remote" >/dev/null 2>&1 || fail "unknown remote: $remote" 3
base=$(git rev-parse --verify -q "refs/remotes/$remote/$branch") ||
  fail "no tracking ref for $remote/$branch: a first publication; review the complete history" 4
git merge-base --is-ancestor "$base" "$reviewed" ||
  fail "DESTRUCTIVE: $reviewed does not descend from the destination tip $base; stop and present this as a destructive action for H's ruling" 5

printf '== binding\nremote=%s\nbranch=%s\nreviewed=%s\nbase=%s (tracking ref, assumed without a fetch)\n' "$remote" "$branch" "$reviewed" "$base"
if [[ $base == "$reviewed" ]]; then
  printf 'up to date: the destination already holds the reviewed commit; nothing to push\n'
  exit 0
fi

status=0
printf '== delta\n'
while IFS=' ' read -r id author committer subject; do
  mark="not made through commit-apply: run the gates on it"
  [[ -f $record_dir/committed ]] && grep -qx "$id" "$record_dir/committed" && mark="made through commit-apply"
  identity=ok
  for address in "$author" "$committer"; do
    [[ $address == *@users.noreply.github.com ]] || { identity="IDENTITY $address is not a GitHub no-reply address"; status=2; }
  done
  printf '%s %s [%s] [%s]\n' "${id:0:7}" "$subject" "$mark" "$identity"
done < <(git log --reverse --format='%H %ae %ce %s' "$base..$reviewed")

printf '== scans\n'
if git diff "$base" "$reviewed" | "$scanner" diff; then printf 'flat diff: accepted\n'; else printf 'flat diff: FINDING\n'; status=2; fi
if git log -p --format= "$base..$reviewed" | "$scanner" diff; then printf 'per-commit patches: accepted\n'; else printf 'per-commit patches: FINDING\n'; status=2; fi

printf '== also published\n'
hooks=$(find "$(git rev-parse --git-path hooks)" -maxdepth 1 -type f ! -name '*.sample' -printf '%f ' 2>/dev/null || true)
printf 'client-side hooks: %s\n' "${hooks:-none}"
printf 'core.hooksPath: %s\n' "$(git config --get core.hooksPath || printf none)"
printf 'push.pushOption: %s\n' "$(git config --get-all push.pushOption | tr '\n' ' ' || printf none)"
tags=$(git log --format=%D "$base..$reviewed" | tr ',' '\n' | sed -n 's/^ *tag: //p' | tr '\n' ' ')
printf 'tags on the delta: %s\n' "${tags:-none}"

if (( status != 0 )); then
  printf 'publish-bind: a finding blocks readiness until H rules on it; no binding recorded\n' >&2
  exit "$status"
fi

mkdir -p -- "$record_root" "$record_dir"
chmod 700 -- "$record_root" "$record_dir"
printf 'remote=%s\nbranch=%s\nlocal=%s\nreviewed=%s\nbase=%s\n' "$remote" "$branch" "$local_branch" "$reviewed" "$base" >"$record_dir/publish"

# The printed tilde is for H's shell to expand, not this one.
# shellcheck disable=SC2088
if [[ $toplevel == "$HOME"/* ]]; then root_arg="~/$(printf '%q' "${toplevel#"$HOME"/}")"; else root_arg=$(printf '%q' "$toplevel"); fi
printf '== command\n'
printf 'git -C %s push %s %s:refs/heads/%s --force-with-lease=refs/heads/%s:%s\n' \
  "$root_arg" "$(printf '%q' "$remote")" "$reviewed" "$(printf '%q' "$branch")" "$(printf '%q' "$branch")" "$base"
