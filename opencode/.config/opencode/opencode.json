{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "openai/gpt-5.6-sol-fast",
  "enabled_providers": ["openai"],
  "skills": {
    "paths": ["~/.claude/skills/omarchy"]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "claude *": "deny",
      "claude --version": "allow",
      "codex *": "deny",
      "codex --version": "allow",
      "opencode *": "deny",
      "opencode --version": "allow",
      "curl *": "deny",
      "dd *": "deny",
      "doas": "deny",
      "doas *": "deny",
      "find * -delete*": "deny",
      "find * -exec *": "deny",
      "find * -execdir *": "deny",
      "find * -ok *": "deny",
      "find * -okdir *": "deny",
      "ftp *": "deny",
      "gh api *": "deny",
      "gh gist create*": "deny",
      "gh gist delete*": "deny",
      "gh gist edit*": "deny",
      "gh issue close*": "deny",
      "gh issue comment*": "deny",
      "gh issue create*": "deny",
      "gh issue edit*": "deny",
      "gh issue reopen*": "deny",
      "gh pr close*": "deny",
      "gh pr create*": "deny",
      "gh pr merge*": "deny",
      "gh release create*": "deny",
      "gh release delete*": "deny",
      "gh release edit*": "deny",
      "gh release upload*": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "git checkout -- *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "tree -o *": "deny",
      "tree --output*": "deny",
      "tree * -o *": "deny",
      "tree * --output *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git restore": "deny",
      "git restore *": "deny",
      "git stash clear": "deny",
      "git stash clear *": "deny",
      "git stash drop": "deny",
      "git stash drop *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "pkexec": "deny",
      "pkexec *": "deny",
      "rm": "deny",
      "rm *": "deny",
      "rmdir": "deny",
      "rmdir *": "deny",
      "rsync *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "socat *": "deny",
      "ssh *": "deny",
      "su": "deny",
      "su *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "truncate *": "deny",
      "wget *": "deny"
    },
    "edit": {
      "*": "allow",
      "../*var/tmp/spar-*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      ".env": "deny",
      "secrets/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "../*var/tmp/spar-*/*.key": "deny",
      "../*var/tmp/spar-*/*.pem": "deny",
      "../*var/tmp/spar-*/*credentials*": "deny",
      "../*var/tmp/spar-*/.env": "deny",
      "../*var/tmp/spar-*/.env.*": "deny",
      "../*var/tmp/spar-*/auth.json": "deny",
      "../*var/tmp/spar-*/secrets/*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "/var/tmp/spar-*": "allow",
      "~/.aws/**": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.docker/config.json": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.ssh/**": "deny"
    },
    "external_context": "ask",
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*credentials*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "secrets/**": "deny",
      "~/.aws/**": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.docker/config.json": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.ssh/**": "deny",
      "../*var/tmp/spar-*/*.key": "deny",
      "../*var/tmp/spar-*/*.pem": "deny",
      "../*var/tmp/spar-*/*credentials*": "deny",
      "../*var/tmp/spar-*/.env": "deny",
      "../*var/tmp/spar-*/.env.*": "deny",
      "../*var/tmp/spar-*/auth.json": "deny",
      "../*var/tmp/spar-*/secrets/*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          "../*var/tmp/spar-*": "allow",
          "../*var/tmp/spar-*/*.key": "deny",
          "../*var/tmp/spar-*/*.pem": "deny",
          "../*var/tmp/spar-*/*credentials*": "deny",
          "../*var/tmp/spar-*/.env": "deny",
          "../*var/tmp/spar-*/.env.*": "deny",
          "../*var/tmp/spar-*/auth.json": "deny",
          "../*var/tmp/spar-*/secrets/*": "deny"
        }
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol-fast": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "instructions": [
    "{env:HOME}/.claude/rules/shared-guidance.md"
  ]
}
