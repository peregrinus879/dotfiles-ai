{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "model": "openai/gpt-5.6-sol-fast",
  "permission": {
    "bash": {
      "*": "ask",
      "claude --version": "allow",
      "codex --version": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git rev-parse --abbrev-ref @{upstream}": "allow",
      "git rev-parse --abbrev-ref HEAD": "allow",
      "git status": "allow",
      "ls": "allow",
      "opencode --version": "allow",
      "pacman -Q*": "allow",
      "pwd": "allow",
      "spar-claude *": "allow",
      "tree": "allow",
      "* >*": "ask",
      "* >>*": "ask",
      "* | tee*": "ask",
      "* 2>*": "ask",
      "* &>*": "ask",
      "*awk*inplace*": "ask",
      "*git apply*": "ask",
      "*patch -p*": "ask",
      "*perl *": "ask",
      "*sed*-i*": "ask",
      "*| perl*": "ask",
      "git reset --hard*": "ask",
      "git restore *": "ask",
      "tree -o *": "deny",
      "tree --output*": "deny",
      "tree * -o *": "deny",
      "tree * --output *": "deny",
      "git push": "deny",
      "git push *": "deny"
    },
    "edit": {
      "*": "ask",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      ".env": "deny",
      "secrets/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.aws/**": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.docker/config.json": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.ssh/**": "deny"
    },
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*credentials*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "secrets/**": "deny",
      "~/.aws/**": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.codex/auth.json": "deny",
      "~/.docker/config.json": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.ssh/**": "deny"
    },
    "webfetch": "ask",
    "websearch": "allow"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*": "deny"
        }
      }
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol-fast": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "instructions": [
    "{env:HOME}/.claude/rules/shared-guidance.md"
  ]
}
