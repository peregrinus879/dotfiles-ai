{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": true,
  "model": "openai/gpt-5.6-sol",
  "permission": {
    "bash": {
      "*": "ask",
      "file": "allow",
      "file *": "allow",
      "claude --version": "allow",
      "claude -p *": "allow",
      "gh search": "allow",
      "gh search *": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git rev-parse --abbrev-ref @{upstream}": "allow",
      "git rev-parse --abbrev-ref HEAD": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "jq *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "opencode --version": "allow",
      "opencode debug *": "allow",
      "pacman -Q*": "allow",
      "pacman -Si *": "allow",
      "pacman -Ss *": "allow",
      "pwd": "allow",
      "tree": "allow",
      "tree *": "allow",
      "* > *": "ask",
      "* >> *": "ask",
      "* | tee *": "ask",
      "* 2> *": "ask",
      "* &> *": "ask",
      "*awk*inplace*": "ask",
      "*perl *": "ask",
      "*sed*-i*": "ask",
      "*| perl*": "ask",
      "tree -o *": "deny",
      "tree --output*": "deny",
      "tree * -o *": "deny",
      "tree * --output *": "deny"
    },
    "edit": "ask",
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4:31b": {
          "name": "gemma4:31b"
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "instructions": [
    "{env:HOME}/.claude/rules/shared-guidance.md"
  ]
}
